# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored -- real keys must never be committed.
#
# Used by: scripts/xmen9-pull-deposits.mjs
# Run it as:  node --env-file=.env scripts/xmen9-pull-deposits.mjs --survey --days=30

# ---- XMEN9 backend API -----------------------------------------------------
# Create these yourself: XMEN9 admin -> MANAGE API -> ADD.
# IMPORTANT: the ADD form pre-ticks ALL 22 modules. Untick "Check/Uncheck All"
# and tick ONLY /transactions/getAllTransactions. The full list includes
# /member/setScore, which transfers credits between users -- a key with that
# enabled can move money, so never grant it to a read-only importer.
XMEN9_ACCESS_ID=
XMEN9_ACCESS_TOKEN=
XMEN9_MERCHANT_ID=

# Optional. Only set if XMEN9 is hosted somewhere other than the usual backend.
# XMEN9_API_URL=https://bkxm9.ns1469.com/api/v1/index.php

# ---- DRW / Supabase (only needed for --live, not for --survey or dry runs) --
# The company these deposits belong to, and the payment_gateways row to file
# them under. Both are uuids from the DRW database.
DRW_COMPANY_ID=
DRW_GATEWAY_ID=

SUPABASE_URL=https://vveydcmdsmucaoqitnch.supabase.co
# Service role key: bypasses RLS. Server-side only, never in frontend code.
SUPABASE_SERVICE_ROLE_KEY=
