# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored -- real keys must never be committed.
#
# Used by: scripts/casino-pull-deposits.mjs
#   node --env-file=.env scripts/casino-pull-deposits.mjs --brand=megabet --survey --days=30

# ============================================================================
#  CASINO BACKEND API
# ============================================================================
# Create the key yourself: casino backend -> MANAGE API -> ADD.
#
#   * Untick "Check/Uncheck All", then tick ONLY
#       /transactions/getAllTransactions
#     The form pre-ticks all 22 modules, and that list includes
#     /member/setScore, which transfers credits between users. A deposit
#     reader must never hold a key that can move money.
#
#   * Leave "Show ... mobile number / bank account / Player Email" unticked
#     unless you actually need those fields to match a deposit -- they put
#     real player details into the API response and into your database.
#
#   * "Whitelisted IP Address" locks the key to one address. If you set it,
#     it must be the address the puller runs from -- note that a home
#     connection's IP usually changes, and Supabase edge functions have no
#     fixed IP.
#
# Per-brand variables win; the plain ones are a fallback, so one .env can
# hold several brands at once.

# MERCHANT ID -- LEAVE IT BLANK ON THE FIRST RUN.
# The API key already identifies its own merchant, so the script omits the
# parameter when you have not set one, and then prints the merchant id the
# returned rows actually carry. Copy that into the variable below.
#
# Do NOT take it from the MANAGE API page: that page's "Grant Access To
# Master BO" is the merchant a key is granted access TO, a different number.
# Using it would not error -- the API would return ANOTHER merchant's
# transactions and they would be filed into your company as if they were
# yours. The script cross-checks every returned row against whatever you set
# here and refuses --live on a mismatch, but blank-then-copy is the safe path.

# ---- MegaBet26 -------------------------------------------------------------
# The API URL has a default built into the script
# (https://jkaswn9.u55y38.com/api/v1/index.php) -- set it only to override.
MEGABET_CASINO_ACCESS_ID=
MEGABET_CASINO_ACCESS_TOKEN=
MEGABET_CASINO_MERCHANT_ID=
# MEGABET_CASINO_API_URL=

# ---- Xmen9 -----------------------------------------------------------------
# XMEN9_CASINO_ACCESS_ID=
# XMEN9_CASINO_ACCESS_TOKEN=
# XMEN9_CASINO_MERCHANT_ID=

# ---- Mario96 ---------------------------------------------------------------
# The API URL built into the script for this brand is a guess based on the
# backend link in DRW and has never been tested -- confirm it before use.
# MARIO96_CASINO_ACCESS_ID=
# MARIO96_CASINO_ACCESS_TOKEN=
# MARIO96_CASINO_MERCHANT_ID=

# ---- fallbacks used when no per-brand value is set -------------------------
# CASINO_ACCESS_ID=
# CASINO_ACCESS_TOKEN=
# CASINO_MERCHANT_ID=
# CASINO_API_URL=

# ============================================================================
#  DRW / SUPABASE  (only needed for --live; not for --survey or dry runs)
# ============================================================================
# Which DRW company the deposits belong to, and which payment_gateways row to
# file them under. Both are uuids from the DRW database. Getting the company
# wrong files one brand's deposits under another tenant.
MEGABET_DRW_COMPANY_ID=
MEGABET_DRW_GATEWAY_ID=
# XMEN9_DRW_COMPANY_ID=
# XMEN9_DRW_GATEWAY_ID=
# DRW_COMPANY_ID=
# DRW_GATEWAY_ID=

SUPABASE_URL=https://vveydcmdsmucaoqitnch.supabase.co
# Service role key: bypasses RLS. Server-side only, never in frontend code.
SUPABASE_SERVICE_ROLE_KEY=
